<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f7fc">
  <title>AI Question Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <link rel="stylesheet" href="/css/ocr.css">
  <script defer src="/js/ocr.js"></script>
</head>
<body>
  <main class="studio-shell">
    <header class="topbar">
      <a class="back-link" href="/teacher/dashboard"><i class="fa-solid fa-arrow-left"></i><span>Teacher dashboard</span></a>
      <span class="topbar-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> AI question studio</span>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">LESS PREP. BETTER QUESTIONS.</span>
        <h1>Turn your study material into an exam.</h1>
        <p>Upload a PDF or image. Review the AI-generated questions, then save them to your question bank or build an exam.</p>
      </div>
      <div class="hero-art" aria-hidden="true"><i class="fa-regular fa-file-lines"></i><span><i class="fa-solid fa-sparkles"></i></span></div>
    </section>

    <section class="workspace">
      <div class="stepper" aria-label="Question creation steps">
        <div class="step active" data-step="1"><span>1</span><b>Upload</b></div><i></i>
        <div class="step" data-step="2"><span>2</span><b>Generate</b></div><i></i>
        <div class="step" data-step="3"><span>3</span><b>Review & save</b></div>
      </div>

      <section class="panel upload-panel" id="uploadPanel">
        <div class="panel-heading"><div><span class="eyebrow">STEP 01</span><h2>Add your material</h2><p>PDFs and images work, including scanned pages.</p></div><span class="heading-icon"><i class="fa-regular fa-file-pdf"></i></span></div>
        <label class="dropzone" id="dropzone" for="sourceFile">
          <input id="sourceFile" type="file" accept="application/pdf,image/png,image/jpeg,image/webp" hidden>
          <span class="upload-symbol"><i class="fa-solid fa-arrow-up-from-bracket"></i></span>
          <strong id="uploadTitle">Choose a PDF or image</strong>
          <span id="uploadHint">Tap to browse or drag a file here</span>
          <small>PDF, PNG, JPG, WEBP · Up to 10 MB</small>
        </label>
        <div class="file-chip hidden" id="fileChip"><i class="fa-regular fa-file-lines"></i><span id="fileName"></span><button type="button" id="removeFile" aria-label="Remove file"><i class="fa-solid fa-xmark"></i></button></div>
        <div class="form-grid">
          <label class="field">Subject<input id="subject" type="text" placeholder="e.g. Mathematics" maxlength="80" required></label>
          <label class="field">Class<input id="className" type="text" placeholder="e.g. Class 9" maxlength="40" required></label>
          <label class="field">Question language<select id="language"><option value="English">English</option><option value="Bengali">বাংলা</option><option value="Hindi">हिन्दी</option></select></label>
          <label class="field">Number of questions<select id="count"><option>5</option><option selected>10</option><option>15</option><option>20</option></select></label>
        </div>
        <div class="notice"><i class="fa-solid fa-shield-halved"></i><span>Your material is processed to create questions. Review every answer before assigning an exam.</span></div>
        <button type="button" class="primary-button full-button" id="generateButton"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate questions</button>
        <div class="status-message hidden" id="statusMessage" role="status"></div>
      </section>

      <section class="panel review-panel hidden" id="reviewPanel">
        <div class="panel-heading review-heading"><div><span class="eyebrow">STEP 02 · REVIEW</span><h2>Check your questions</h2><p>Edit wording or correct answers before saving.</p></div><span class="question-count" id="questionCount">0 questions</span></div>
        <div class="review-list" id="reviewList"></div>
        <div class="status-message hidden" id="reviewStatus" role="status"></div>
        <div class="review-actions"><button type="button" class="secondary-button" id="backButton"><i class="fa-solid fa-arrow-left"></i> Change source</button><button type="button" class="secondary-button save-button" id="saveButton"><i class="fa-regular fa-floppy-disk"></i> Save questions</button><button type="button" class="primary-button" id="createExamButton"><i class="fa-solid fa-circle-plus"></i> Create exam</button></div>
        <p class="saved-note hidden" id="savedNote"><i class="fa-solid fa-circle-check"></i> Questions saved to your database.</p>
      </section>
    </section>
  </main>

  <dialog class="exam-dialog" id="examDialog">
    <form method="dialog" class="dialog-close-row"><button class="icon-button" value="cancel" aria-label="Close"><i class="fa-solid fa-xmark"></i></button></form>
    <div class="dialog-heading"><span class="eyebrow">EXAM SETUP</span><h2>Create an exam</h2><p>Choose when students can take this exam.</p></div>
    <form id="examForm">
      <label class="field">Exam title<input id="examTitle" required maxlength="100" placeholder="e.g. Chapter 4 Assessment"></label>
      <div class="form-grid"><label class="field">Starts at<input id="startTime" type="datetime-local" required></label><label class="field">Ends at<input id="endTime" type="datetime-local" required></label><label class="field">Duration (minutes)<input id="duration" type="number" min="1" max="600" value="30" required></label><label class="field">Marks per question<input id="marksPerQuestion" type="number" min="1" max="100" value="1" required></label></div>
      <div class="student-picker"><div class="picker-title"><div><strong>Assign to students</strong><span id="studentCount">Loading students…</span></div><button type="button" class="text-button" id="toggleStudents">Select all</button></div><div class="student-list" id="studentList"></div></div>
      <div class="status-message hidden" id="examStatus" role="status"></div>
      <button class="primary-button full-button" id="publishExam" type="submit"><i class="fa-solid fa-paper-plane"></i> Create and assign exam</button>
    </form>
  </dialog>
</body>
</html>
