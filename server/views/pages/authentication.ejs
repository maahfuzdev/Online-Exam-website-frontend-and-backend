<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f3f6fb">
  <title>Sign in · QuizMaster</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/authentication.css">
  <script defer src="/js/authentication.js"></script>
</head>
<body>
  <main class="auth-page">
    <header class="auth-topbar">
      <a class="brand" href="/" aria-label="QuizMaster home"><span class="brand-mark">Q</span><span>QuizMaster<small>EXAM PLATFORM</small></span></a>
      <a class="back-home" href="/"><i class="fa-solid fa-arrow-left"></i><span>Back to home</span></a>
    </header>

    <div class="auth-layout">
      <aside class="welcome-panel">
        <div class="welcome-content">
          <span class="welcome-eyebrow"><i class="fa-solid fa-sparkles"></i> YOUR LEARNING WORKSPACE</span>
          <h1>Every exam starts with a great experience.</h1>
          <p>Sign in to create assessments, take exams, and keep your learning on track.</p>
          <div class="welcome-features">
            <div><span class="feature-icon"><i class="fa-solid fa-pen-to-square"></i></span><span><strong>Thoughtful assessments</strong><small>Build clear, organized exams with ease.</small></span></div>
            <div><span class="feature-icon"><i class="fa-solid fa-chart-line"></i></span><span><strong>Progress at a glance</strong><small>See results and follow improvement.</small></span></div>
          </div>
        </div>
        <div class="welcome-foot"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="welcome-mark"><i class="fa-solid fa-graduation-cap"></i></span><span class="foot-copy">A focused space for better learning</span></div>
      </aside>

      <section class="auth-card" aria-labelledby="authTitle">
        <div class="auth-card-heading">
          <span class="card-eyebrow" id="modeEyebrow">WELCOME BACK</span>
          <h2 id="authTitle">Sign in to your account</h2>
          <p id="authSubtitle">Enter your details to continue to QuizMaster.</p>
        </div>

        <div class="role-block" id="roleBlock" hidden>
          <span class="role-label">I am joining as</span>
          <div class="role-selector" aria-label="Choose your account type">
            <button type="button" class="role-btn active" id="teacherRoleBtn" aria-pressed="true" data-role="teacher"><i class="fa-solid fa-chalkboard-user"></i><span>Teacher</span></button>
            <button type="button" class="role-btn" id="studentRoleBtn" aria-pressed="false" data-role="student"><i class="fa-solid fa-user-graduate"></i><span>Student</span></button>
          </div>
        </div>

        <div id="messageContainer" aria-live="polite" aria-atomic="true"></div>

        <form id="loginForm" class="auth-form" novalidate>
          <label class="field"><span>Email address</span><span class="input-wrap"><i class="fa-regular fa-envelope field-icon"></i><input type="email" id="loginEmail" name="email" placeholder="you@example.com" autocomplete="email" required></span></label>
          <label class="field"><span>Password</span><span class="input-wrap"><i class="fa-solid fa-lock field-icon"></i><input type="password" id="loginPassword" name="password" placeholder="Enter your password" autocomplete="current-password" required><button type="button" class="password-toggle" data-password="loginPassword" aria-label="Show password"><i class="fa-regular fa-eye"></i></button></span></label>
          <button type="submit" class="submit-btn" id="signInBtn"><span>Sign in</span><i class="fa-solid fa-arrow-right"></i></button>
          <p class="form-switch">New to QuizMaster? <button type="button" class="text-action" data-toggle-form>Create an account</button></p>
        </form>

        <form id="registerForm" class="auth-form hidden" novalidate>
          <label class="field"><span>Full name</span><span class="input-wrap"><i class="fa-regular fa-user field-icon"></i><input type="text" id="registerName" name="name" placeholder="Your full name" autocomplete="name" maxlength="100" required></span></label>
          <label class="field"><span>Email address</span><span class="input-wrap"><i class="fa-regular fa-envelope field-icon"></i><input type="email" id="registerEmail" name="email" placeholder="you@example.com" autocomplete="email" required></span></label>
          <label class="field"><span>Password</span><span class="input-wrap"><i class="fa-solid fa-lock field-icon"></i><input type="password" id="registerPassword" name="new-password" placeholder="At least 6 characters" autocomplete="new-password" minlength="6" required><button type="button" class="password-toggle" data-password="registerPassword" aria-label="Show password"><i class="fa-regular fa-eye"></i></button></span></label>
          <div id="passwordStrength" class="password-strength" aria-live="polite"></div>
          <label class="field"><span>Confirm password</span><span class="input-wrap"><i class="fa-solid fa-lock field-icon"></i><input type="password" id="confirmPassword" name="confirm-password" placeholder="Enter your password again" autocomplete="new-password" required><button type="button" class="password-toggle" data-password="confirmPassword" aria-label="Show password"><i class="fa-regular fa-eye"></i></button></span></label>
          <button type="submit" class="submit-btn" id="signUpBtn"><span>Create account</span><i class="fa-solid fa-arrow-right"></i></button>
          <p class="form-switch">Already have an account? <button type="button" class="text-action" data-toggle-form>Sign in</button></p>
        </form>

        <p class="security-note"><i class="fa-solid fa-shield-halved"></i> Your account details are protected and kept private.</p>
      </section>
    </div>
    <footer class="auth-footer"><span>© <span id="year"></span> QuizMaster</span><span>Learn. Assess. Grow.</span></footer>
  </main>
</body>
</html>
