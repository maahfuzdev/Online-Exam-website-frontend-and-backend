    <!-- Exam Interface -->
    <div id="examContainer" class="exam-container hidden">
        <!-- Exam Header -->
        <div class="exam-header">
            <div class="exam-info">
                <h1 id="examTitleDisplay">Mathematics Final Exam</h1>
                <div class="exam-meta">
                    <span class="exam-meta-item" id="examQuestionsCount">10 Questions</span>
                    <span class="exam-meta-item" id="examTotalMarks">Total: 100 marks</span>
                    <span class="exam-meta-item exam-timer" id="examTimeRemaining" aria-live="polite">⏱️ Time: 01:30:00</span>
                </div>
            </div>
            <button type="button" class="btn btn-primary submit-exam-btn" onclick="confirmSubmitExam()">Submit exam</button>
        </div>

        <!-- Exam Timer Alert -->
        <div id="timeWarning" class="time-warning hidden">
            ⚠️ <span id="timeWarningText">Time is running out!</span>
        </div>

        <!-- Exam Progress -->
        <div class="exam-progress">
            <div class="progress-bar">
                <div id="examProgressFill" class="progress-fill" style="width: 10%;"></div>
            </div>
            <div class="progress-info">
                <span id="currentQuestionNumber">Question 1</span>
                <span id="examProgressText" aria-live="polite">0/10 answered</span>
            </div>
        </div>

        <!-- Questions Navigation -->
        <div id="questionsNav" class="questions-nav">
            <!-- Questions numbers will be dynamically added here -->
        </div>

        <!-- Question Display Area -->
        <div class="question-display-area">
            <div class="question-card" id="currentQuestionCard">
                <div class="question-header">
                    <h3 id="questionNumberDisplay">Question 1</h3>
                    <span class="marks-badge" id="questionMarks">10 marks</span>
                </div>

                <div class="question-content">
                    <div class="question-text" id="questionTextDisplay">

                    </div>

                    <!-- Options/Answer Area -->
                    <div class="answer-section">
                        <!-- Multiple Choice -->
                        <div id="mcqOptions" class="mcq-options" role="radiogroup" aria-label="Answer choices" onkeydown="handleMCQKeydown(event)">
                            <button type="button" class="option-row" role="radio" aria-checked="false" tabindex="0" onclick="selectMCQOption(0)">
                                <span class="option-label">A</span>
                                <span class="option-text" id="optionA">3.14</span>
                            </button>
                            <button type="button" class="option-row" role="radio" aria-checked="false" tabindex="0" onclick="selectMCQOption(1)">
                                <span class="option-label">B</span>
                                <span class="option-text" id="optionB">3.15</span>
                            </button>
                            <button type="button" class="option-row" role="radio" aria-checked="false" tabindex="0" onclick="selectMCQOption(2)">
                                <span class="option-label">C</span>
                                <span class="option-text" id="optionC">3.16</span>
                            </button>
                            <button type="button" class="option-row" role="radio" aria-checked="false" tabindex="0" onclick="selectMCQOption(3)">
                                <span class="option-label">D</span>
                                <span class="option-text" id="optionD">3.17</span>
                            </button>
                        </div>
                        <section id="writtenAnswerSection" class="written-answer-panel hidden" aria-labelledby="writtenAnswerTitle">
                            <div class="written-answer-panel-heading">
                                <span class="written-answer-icon"><i class="fas fa-file-arrow-up" aria-hidden="true"></i></span>
                                <div><h4 id="writtenAnswerTitle">Handwritten answer</h4><p>Attach a clear photo or PDF for this question.</p></div>
                            </div>
                            <input id="writtenAnswerFile" class="written-answer-input" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" onchange="handleWrittenAnswerFile(event)">
                            <label class="written-answer-dropzone" for="writtenAnswerFile">
                                <i class="fas fa-cloud-arrow-up" aria-hidden="true"></i>
                                <span><strong>Choose an image or PDF</strong><small>JPG, PNG, WebP or PDF · up to 8 MB</small></span>
                            </label>
                            <div id="writtenAnswerFeedback" class="written-answer-feedback" role="status" aria-live="polite"></div>
                        </section>
                    </div>
                </div>

                <div class="question-navigation">
                    <button type="button" class="btn btn-outline" onclick="previousQuestionExam()" id="prevQuestionBtn">
                        ← Previous
                    </button>
                    <div class="answer-status" id="answerStatus">Not answered</div>
                    <button type="button" class="btn btn-primary" onclick="nextQuestionExam()" id="nextQuestionBtn">
                        Next →
                    </button>
                </div>
            </div>
        </div>

    </div>
