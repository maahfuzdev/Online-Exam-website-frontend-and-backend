  <!-- Teacher Dashboard -->
  <div id="teacherDashboard" class="dashboard teacher-dashboard hidden">
    <div class="dashboard-header">
      <button class="back-btn" onclick="TeacherDash()">← Back</button>
      <h1 class="dashboard-title"> Teacher Dashboard</h1>
      <p class="dashboard-subtitle">Create amazing quizzes with mathematical equations</p>
    </div>

    <div class="teacher-panel">
      <div class="exam-workflow-heading">
        <div>
          <p class="workflow-eyebrow">EXAM WORKSPACE</p>
          <h2>Build an exam</h2>
          <p>Create your question set, review it, then schedule and assign it.</p>
        </div>
        <div class="workflow-summary"><span class="summary-dot"></span> Draft in progress</div>
      </div>

      <nav class="exam-stepper" aria-label="Exam creation steps">
        <button type="button" class="exam-step active" data-exam-step="1" onclick="showExamStep(1)">
          <span class="exam-step-number">01</span><span><strong>Build</strong><small>Create questions</small></span>
        </button>
        <span class="exam-step-connector"></span>
        <button type="button" class="exam-step" data-exam-step="2" onclick="showExamStep(2)">
          <span class="exam-step-number">02</span><span><strong>Review</strong><small>Browse saved questions</small></span>
        </button>
        <span class="exam-step-connector"></span>
        <button type="button" class="exam-step" data-exam-step="3" onclick="showExamStep(3)">
          <span class="exam-step-number">03</span><span><strong>Assign</strong><small>Set exam and students</small></span>
        </button>
      </nav>

      <section class="exam-step-panel" id="examStep1">
        <div class="section-title">
           Question Creator
        </div>

        <div class="question-creator-launcher">
          <button type="button" class="creator-launch-button" onclick="toggleQuestionTypeChooser()">
            <span class="creator-launch-icon" aria-hidden="true">＋</span>
            <span><strong>Create a question</strong><small>Choose a question type to get started</small></span>
            <span class="creator-launch-arrow" aria-hidden="true">⌄</span>
          </button>
        </div>

        <div id="questionTypeChooser" class="question-type-chooser hidden" aria-label="Choose question type">
          <button type="button" class="question-type-card" onclick="beginQuestionCreation('mathematical')">
            <span class="question-type-icon">∑</span>
            <span><strong>Mathematical</strong><small>Formula templates, LaTeX input, and live preview</small></span>
            <span class="question-type-arrow">→</span>
          </button>
          <button type="button" class="question-type-card" onclick="beginQuestionCreation('general')">
            <span class="question-type-icon general">Aa</span>
            <span><strong>General</strong><small>Text question, with formula tools available if needed</small></span>
            <span class="question-type-arrow">→</span>
          </button>
          <button type="button" class="question-type-card bulk-question-type-card" onclick="openBulkQuestionCreator()">
            <span class="question-type-icon bulk"> <i class="fas fa-paste"></i> </span>
            <span><strong>Paste many questions</strong><small>Paste MCQs with A-D choices and answer keys</small></span>
            <span class="question-type-arrow">→</span>
          </button>
        </div>

        <section class="form-section bulk-question-creator hidden" id="bulkQuestionCreator" aria-labelledby="bulkQuestionHeading">
          <div class="creator-form-heading">
            <div><span class="creator-eyebrow">BATCH QUESTION IMPORT</span><h3 id="bulkQuestionHeading">Paste a question set</h3><p class="creator-help">We'll split the questions, choices and correct answers, then let you review them before saving.</p></div>
            <button type="button" class="creator-back-button" onclick="closeBulkQuestionCreator()">Back to question types</button>
          </div>
          <div class="question-metadata-grid">
            <div><label class="form-label" for="bulkQuestionSubject">Subject</label><input id="bulkQuestionSubject" class="form-input" type="text" placeholder="e.g., Physics" required></div>
            <div><label class="form-label" for="bulkQuestionClass">Class / Grade</label><input id="bulkQuestionClass" class="form-input" type="text" placeholder="e.g., Class 11" required></div>
          </div>
          <label class="form-label" for="bulkQuestionInput">Paste your MCQs</label>
          <p class="creator-help">Use four ordered choices such as <strong>a)-d), (a)-(d), A.-D., or à¦•)-à¦˜)</strong>, then add an answer key such as <strong>à¦‰à¦¤à§à¦¤à¦°: à¦–</strong>, <strong>Answer: B</strong>, or <strong>Correct answer: B</strong>. Questions may be numbered or unnumbered. Supports Bangla, English and LaTeX.</p>
          <textarea id="bulkQuestionInput" class="form-input bulk-question-input" rows="12" placeholder="Paste each question, its a)-d) choices, then an answer line such as à¦‰à¦¤à§à¦¤à¦°: b) Correct choice"></textarea>
          <div class="bulk-question-actions">
            <span id="bulkQuestionStatus" class="bulk-question-status" role="status">Paste questions to get started. Supports up to 100 per batch.</span>
            <button type="button" class="btn btn-primary" onclick="parseBulkQuestions()"><i class="fas fa-wand-magic-sparkles"></i> Parse and review</button>
          </div>
          <div id="bulkQuestionPreview" class="bulk-question-preview hidden"></div>
          <div class="bulk-question-save-row hidden" id="bulkQuestionSaveRow">
            <span id="bulkQuestionSaveCount"></span>
            <button type="button" class="btn btn-success" id="saveBulkQuestionsButton" onclick="saveBulkQuestions()"><i class="fas fa-cloud-arrow-up"></i> Save all questions</button>
          </div>
        </section>

        <div class="form-section question-creator-form hidden" id="questionCreatorForm">
          <div class="creator-form-heading">
            <div><span class="creator-eyebrow">NEW QUESTION</span><h3 id="questionTypeHeading">Create a question</h3></div>
            <button type="button" class="creator-back-button" onclick="backToQuestionTypeChooser()">Change type</button>
          </div>
          <div class="question-metadata-grid">
            <div><label class="form-label" for="questionSubject">Subject</label><input id="questionSubject" class="form-input" type="text" placeholder="e.g., Mathematics" required></div>
            <div><label class="form-label" for="questionClass">Class / Grade</label><input id="questionClass" class="form-input" type="text" placeholder="e.g., Class 10" required></div>
          </div>
          <div class="form-group"><label class="form-label" for="answerTypeSelect">Answer type</label><select id="answerTypeSelect" class="form-input" onchange="toggleQuestionAnswerType()"><option value="mcq">MCQ</option><option value="written">Written answer</option></select><p class="creator-help">Written questions have no answer key. Students upload a photo or PDF, and you award marks manually.</p></div>

          <div class="form-group">
            <label class="form-label" for="questionInput">Question</label>
            <p class="creator-help">Write normally, type LaTeX such as \(x^2\), or use the math keyboard. Formulas appear in the preview and in the student exam.</p>
            <details class="math-toolbar">
              <summary class="math-toolbar-title">Math keyboard <span>Tap a key to insert it - no LaTeX needed</span></summary>
              <div class="math-keyboard" aria-label="Math keyboard">
                <div class="math-keyboard-section"><span>Numbers</span><div class="math-buttons">
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('0')" aria-label="Insert 0">0</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('1')" aria-label="Insert 1">1</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('2')" aria-label="Insert 2">2</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('3')" aria-label="Insert 3">3</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('4')" aria-label="Insert 4">4</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('5')" aria-label="Insert 5">5</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('6')" aria-label="Insert 6">6</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('7')" aria-label="Insert 7">7</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('8')" aria-label="Insert 8">8</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('9')" aria-label="Insert 9">9</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('.')" aria-label="Decimal point">.</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('(')" aria-label="Open parenthesis">(</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol(')')" aria-label="Close parenthesis">)</button>
                </div></div>
                <div class="math-keyboard-section"><span>Operations</span><div class="math-buttons">
                  <button type="button" class="math-btn math-key math-key-accent" onclick="insertMathSymbol('+')" aria-label="Plus">+</button>
                  <button type="button" class="math-btn math-key math-key-accent" onclick="insertMathSymbol('−')" aria-label="Minus">−</button>
                  <button type="button" class="math-btn math-key math-key-accent" onclick="insertMathSymbol('x')" aria-label="Multiply">x</button>
                  <button type="button" class="math-btn math-key math-key-accent" onclick="insertMathSymbol('÷')" aria-label="Divide">÷</button>
                  <button type="button" class="math-btn math-key math-key-accent" onclick="insertMathSymbol('=')" aria-label="Equals">=</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('±')" aria-label="Plus or minus">±</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('≤')" aria-label="Less than or equal">≤</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('≥')" aria-label="Greater than or equal">≥</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('≠')" aria-label="Not equal">≠</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('%')" aria-label="Percent">%</button>
                </div></div>
                <div class="math-keyboard-section"><span>Common math</span><div class="math-buttons">
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('√()', 2)" aria-label="Square root">√</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('x²')" aria-label="x squared">x²</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('x³')" aria-label="x cubed">x³</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('xⁿ')" aria-label="Power template">xⁿ</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('()/()', 1)" aria-label="Fraction">a/b</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('½')" aria-label="One half">½</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('¼')" aria-label="One quarter">¼</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('π')" aria-label="Pi">π</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('∞')" aria-label="Infinity">∞</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('θ')" aria-label="Theta">θ</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('α')" aria-label="Alpha">α</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('β')" aria-label="Beta">β</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('Σ')" aria-label="Sum">Σ</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('∫')" aria-label="Integral">∫</button>
                </div></div>
                <div class="math-keyboard-section"><span>Superscript numbers</span><div class="math-buttons">
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁰')" aria-label="Insert superscript 0">⁰</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('¹')" aria-label="Insert superscript 1">¹</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('²')" aria-label="Insert superscript 2">²</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('³')" aria-label="Insert superscript 3">³</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁴')" aria-label="Insert superscript 4">⁴</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁵')" aria-label="Insert superscript 5">⁵</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁶')" aria-label="Insert superscript 6">⁶</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁷')" aria-label="Insert superscript 7">⁷</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁸')" aria-label="Insert superscript 8">⁸</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('⁹')" aria-label="Insert superscript 9">⁹</button>
                </div></div>
                <div class="math-keyboard-section"><span>Functions</span><div class="math-buttons">
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('sin()', 4)">sin</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('cos()', 4)">cos</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('tan()', 4)">tan</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('log()', 4)">log</button>
                  <button type="button" class="math-btn math-key" onclick="insertMathSymbol('ln()', 3)">ln</button>
                </div></div>
              </div>
            </details>
            <details class="latex-keyboard">
              <summary>Formula tools <span>Insert LaTeX templates directly into the focused field</span></summary>
              <div class="latex-key-grid" aria-label="LaTeX formula tools">
                <button type="button" class="latex-key" data-latex="&#92;(&#92;frac{}{}&#92;)" data-cursor="8"><b>a&frasl;b</b><span>Fraction</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;sqrt{}&#92;)" data-cursor="7"><b>&#8730;x</b><span>Square root</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(x^{}&#92;)" data-cursor="5"><b>x<sup>n</sup></b><span>Power</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(x_{}&#92;)" data-cursor="5"><b>x<sub>n</sub></b><span>Subscript</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;pi&#92;)" data-cursor="7"><b>&#960;</b><span>Pi</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(\sin()&#92;)" data-cursor="7"><b>sin</b><span>Sine</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(\cos()&#92;)" data-cursor="7"><b>cos</b><span>Cosine</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;theta&#92;)" data-cursor="10"><b>&#952;</b><span>Theta</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;le&#92;)" data-cursor="8"><b>&le;</b><span>Less or equal</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;ge&#92;)" data-cursor="8"><b>&ge;</b><span>Greater or equal</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;times&#92;)" data-cursor="11"><b>&times;</b><span>Multiply</span></button>
                <button type="button" class="latex-key" data-latex="&#92;(&#92;div&#92;)" data-cursor="9"><b>&divide;</b><span>Divide</span></button>
              </div>
              <p class="latex-keyboard-help">Write LaTeX directly using <code>\( ... \)</code> for inline math or <code>\[ ... \]</code> for a displayed equation.</p>
            </details>
            <textarea id="questionInput" class="form-input" rows="3"
              placeholder="Type your question, or add LaTeX such as \\(x^2\\)."></textarea>
            <div
              style="margin-top: 10px; padding: 15px; background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0;">
              <div class="question-preview-heading">Live preview</div>
              <div id="questionPreview" style="font-size: 1.1rem; line-height: 1.6;">Type your question to see
                preview...
              </div>
              <div id="choice1Preview" style="font-size: 1.1rem; line-height: 1.6; margin-top: 5px;"></div>
              <div id="choice2Preview" style="font-size: 1.1rem; line-height: 1.6; margin-top: 5px;"></div>
              <div id="choice3Preview" style="font-size: 1.1rem; line-height: 1.6; margin-top: 5px;"></div>
              <div id="choice4Preview" style="font-size: 1.1rem; line-height: 1.6; margin-top: 5px;"></div>
            </div>
          </div>

          <div class="form-group" id="mcqChoicesGroup">
            <label class="form-label"> Answer Choices</label>
            <p class="creator-help">Enter four options. LaTeX formulas are supported; tap the correct answer letter.</p>
            <div class="choices-grid">
              <div class="choice-input">
                <input type="text" id="choice1" class="form-input" aria-label="Choice A" placeholder="Choice A (e.g., 1/2)">

                <button type="button" class="correct-marker inactive" onclick="setCorrectAnswer(0)" aria-label="Mark choice A as correct" aria-pressed="false">A</button>
              </div>
              <div class="choice-input">
                <input type="text" id="choice2" class="form-input" aria-label="Choice B" placeholder="Choice B (e.g., x²)">
                <button type="button" class="correct-marker inactive" onclick="setCorrectAnswer(1)" aria-label="Mark choice B as correct" aria-pressed="false">B</button>
              </div>
              <div class="choice-input">
                <input type="text" id="choice3" class="form-input" aria-label="Choice C" placeholder="Choice C (e.g., √x)">
                <button type="button" class="correct-marker inactive" onclick="setCorrectAnswer(2)" aria-label="Mark choice C as correct" aria-pressed="false">C</button>
              </div>
              <div class="choice-input">
                <input type="text" id="choice4" class="form-input" aria-label="Choice D" placeholder="Choice D (e.g., πr²)">
                <button type="button" class="correct-marker inactive" onclick="setCorrectAnswer(3)" aria-label="Mark choice D as correct" aria-pressed="false">D</button>
              </div>
            </div>
            <div style="text-align: center; margin-top: 15px;">
              <p style="color: #10b981; font-weight: 600; margin-bottom: 5px;">
                ✅ Click on A, B, C, or D to mark the correct answer
              </p>
              <p id="correctIndicator" style="color: #667eea; font-weight: 700;">
                No correct answer selected
              </p>
            </div>
          </div>

          <div class="action-buttons">
            <button class="btn btn-success" onclick="addQuestion(event)">Add question</button>
          </div>
        </div>

        <div class="workflow-actions workflow-actions-end">
          <span class="workflow-hint">Add questions, then review the complete set.</span>
          <button type="button" class="workflow-next" onclick="showExamStep(2)">Review questions <span
              aria-hidden="true">→</span></button>
        </div>
      </section>

      <div id="questionBankModal" class="question-bank-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="questionBankTitle">
        <section class="question-bank-modal">
          <header class="question-bank-header">
            <div><span class="creator-eyebrow">YOUR LIBRARY</span><h3 id="questionBankTitle">Question bank</h3><p>Filter questions by subject and class.</p></div>
            <button type="button" class="question-bank-close" onclick="closeQuestionBank()" aria-label="Close question bank">x</button>
          </header>
          <div class="question-bank-filters">
            <label>Subject<select id="questionBankSubject" onchange="filterQuestionBank()"><option value="">All subjects</option></select></label>
            <label>Class / Grade<select id="questionBankClass" onchange="filterQuestionBank()"><option value="">All classes</option></select></label>
          </div>
          <div id="questionBankResults" class="question-bank-results"></div>
        </section>
      </div>

      <section class="exam-step-panel hidden" id="examStep2">
        <div class="stats-grid">
          <div class="stat-card"><div class="stat-number" id="totalQuestions">0</div><div class="stat-label">Saved questions</div></div>
          <div class="stat-card"><div class="stat-number" id="readyStatus">Not Ready</div><div class="stat-label">Question status</div></div>
          <div class="stat-card"><div class="stat-number" id="mathQuestions">0</div><div class="stat-label">Math questions</div></div>
        </div>
        <div class="form-section review-intro-card">
          <div class="section-title">Your question library</div>
          <p class="bank-section-description">Browse saved questions by subject and class. Choose the questions for this exam in the assignment step.</p>
          <button type="button" class="question-bank-launch review-bank-launch" onclick="openQuestionBank()">Browse question bank</button>
          <div class="questions-list hidden" id="questionsList"><p style="text-align:center;color:#64748b;">No questions added yet.</p></div>
        </div>
        <div class="workflow-actions">
          <button type="button" class="workflow-back" onclick="showExamStep(1)"><span aria-hidden="true">←</span> Back
            to builder</button>
          <button type="button" class="workflow-next" onclick="showExamStep(3)">Set up exam <span
              aria-hidden="true">→</span></button>
        </div>
      </section>

      <!--Teacher Create & Assign Exam Section-->
      <section class="exam-step-panel hidden" id="examStep3">
        <!-- Stylish Header -->
        <div style="
              background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
              padding: 30px;
              border-radius: 22px;
              margin-bottom: 35px;
              color: white;
              box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
          ">
          <h2
            style="font-size: 30px; font-weight: 800; margin-bottom: 8px; display: flex; align-items: center; gap: 12px;">
             Create New Exam
          </h2>
          <p style="opacity: 0.95; font-size: 15px;">Assign questions & schedule exams with ease</p>
        </div>


        <!-- Main Exam Creation Card -->
        <div style="
              background: white;
              padding: 35px;
              border-radius: 20px;
              box-shadow: 0 25px 70px rgba(0,0,0,0.07);
              border: 1px solid #ececec;
              margin-bottom: 45px;
          ">

          <!-- Step 1 -->
          <h3 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-3">
            <span
              class="w-9 h-9 bg-blue-500 text-white rounded-xl flex items-center justify-center text-lg font-semibold">1</span>
            Basic Exam Information
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Exam Title -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700" for="examTitle">Exam title</label>
              <input id="examTitle" type="text" placeholder="e.g., Mid Term Exam - Math"
                class="w-full px-4 py-3.5 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 shadow-sm hover:shadow-md">
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700" for="examSubject">Subject</label>
              <input id="examSubject" type="text" placeholder="e.g., Mathematics"
                class="w-full px-4 py-3.5 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 shadow-sm hover:shadow-md">
            </div>

            <!-- Marks Per Question -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700" for="marksPerQuestion">Marks per question</label>
              <div class="relative">
                <input id="marksPerQuestion" type="number" min="1" value="1"
                  class="w-full px-4 py-3.5 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 shadow-sm hover:shadow-md appearance-none">
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <span class="text-gray-500 text-sm">marks</span>
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <!-- Total Duration -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700" for="totalTime">Exam duration</label>
              <div class="relative">
                <input id="totalTime" type="number" min="1" value="60"
                  class="w-full px-4 py-3.5 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 shadow-sm hover:shadow-md appearance-none">
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <span class="text-gray-500 text-sm">minutes</span>
                </div>
              </div>
              <p class="text-xs text-gray-500 mt-1">Total time allowed for the exam</p>
            </div>

            <!-- Start Time -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700" for="startTime">Start date &amp; time</label>
              <div class="relative group">
                <input id="startTime" type="datetime-local"
                  class="w-full px-4 py-3.5 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 shadow-sm hover:shadow-md appearance-none [color-scheme:light]">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              </div>
            </div>

            <!-- End Time -->
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700" for="endTime">End date &amp; time</label>
              <div class="relative group">
                <input id="endTime" type="datetime-local"
                  class="w-full px-4 py-3.5 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 shadow-sm hover:shadow-md appearance-none [color-scheme:light]">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <section class="exam-policy-panel" aria-labelledby="examPolicyHeading">
            <div class="exam-policy-heading"><span>EXAM SETTINGS</span><h3 id="examPolicyHeading">Answers, scoring &amp; result release</h3><p>Choose whether students can attach handwritten work, how wrong answers are scored, and when results are visible.</p></div>
            <div class="exam-policy-grid">
              <label class="exam-policy-toggle" for="negativeMarkingEnabled"><input id="negativeMarkingEnabled" type="checkbox" onchange="toggleNegativeMarking()"><span><strong>Use negative marking</strong><small>Deduct marks for incorrect answers.</small></span></label>
              <label class="exam-policy-toggle" for="writtenAnswersEnabled"><input id="writtenAnswersEnabled" type="checkbox"><span><strong>Allow handwritten answer uploads</strong><small>Students can attach one image or PDF per question for teacher review.</small></span></label>
              <label class="exam-policy-field" for="negativeMarkPerWrong"><span>Deduction per wrong answer</span><span class="exam-policy-number"><input id="negativeMarkPerWrong" type="number" min="0" step="0.25" value="0.25" disabled><small>marks</small></span></label>
              <label class="exam-policy-field exam-result-policy" for="resultVisibility"><span>Students can see results</span><select id="resultVisibility"><option value="immediate">Immediately after submitting</option><option value="after_exam_end">After the exam closes</option><option value="teacher_release">When I release them</option></select></label>
            </div>
            <p class="exam-policy-help" id="resultVisibilityHelp">Students will see their score and answer review as soon as they submit.</p>
          </section>

          <!-- Step 2 -->
          <h3
            style="font-size:21px; font-weight:700; color:#374151; margin:35px 0 20px; display:flex; gap:12px; align-items:center;">
            <span
              style="background:#10b981; color:white; width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center;">2</span>
            Select Students & Questions
          </h3>

          <div class="assignment-pickers">
            <div class="form-group exam-type-selector"><label class="form-label" for="examType">Exam type</label><select id="examType" class="form-input" onchange="changeExamType()"><option value="mcq">MCQ exam</option><option value="written">Written exam</option></select><p class="creator-help" id="examTypeHelp">Only MCQ questions will appear in the question picker.</p></div>
            <details class="assignment-picker">
              <summary><span>Choose students</span><span class="picker-count" id="studentPickerCount">0 selected</span></summary>
              <div class="picker-content">
                <div class="picker-tools"><span>Students</span><button type="button" class="picker-select-all" onclick="selectAllStudents()">Select all</button></div>
                <input id="studentSearch" class="assignment-search" type="search" placeholder="Search by name or email" aria-label="Search students" oninput="renderStudentsList()">
                <div id="studentsContainer" class="assignment-list"><div class="assignment-loading">Loading students...</div></div>
                <div class="picker-total"><span id="selectedStudentsCount">0 selected</span><span id="totalStudentsCount">Total: 0</span></div>
              </div>
            </details>
            <details class="assignment-picker">
              <summary><span>Choose questions</span><span class="picker-count" id="questionPickerCount">0 selected</span></summary>
              <div class="picker-content">
                <div class="picker-tools"><span>Questions</span><button type="button" class="picker-select-all" onclick="selectAllQuestions()" title="Select only questions currently shown by the filters">Select all shown</button></div>
                <div class="question-selection-filters">
                  <select id="scheduleQuestionSubject" aria-label="Filter questions by subject" onchange="renderQuestionsList()"><option value="">All subjects</option></select>
                  <select id="scheduleQuestionClass" aria-label="Filter questions by class" onchange="renderQuestionsList()"><option value="">All classes</option></select>
                </div>
                <input id="scheduleQuestionSearch" class="assignment-search" type="search" placeholder="Search question text" aria-label="Search questions" oninput="renderQuestionsList()">
                <div id="questionsContainer" class="assignment-list"><div class="assignment-loading">Loading questions...</div></div>
                <div class="picker-total"><span id="selectedQuestionsCount">0 selected</span><span id="totalQuestionsCount">Total: 0</span></div>
              </div>
            </details>
          </div>
          <div class="exam-form-actions">
            <button id="saveExamButton" class="create-assignment-button" onclick="createAndAssignExam()">Create exam and assign</button>
            <button id="cancelEditExamButton" class="cancel-exam-edit hidden" type="button" onclick="cancelExamEdit()">Cancel editing</button>
          </div>

          <p style="text-align:center; margin-top:12px; font-size:14px; color:#6b7280;">Assigned students can open the exam during the schedule you set.</p>
        </div>


        <details class="created-exams-panel">
          <summary>Previously created exams <span>View list</span></summary>
          <div id="examsList" style="min-height:90px;"><div style="text-align:center;padding:28px;color:#9ca3af;">No exams created yet.</div></div>
        </details>

        <div class="workflow-actions">
          <button type="button" class="workflow-back" onclick="showExamStep(2)"><span aria-hidden="true">←</span> Back
            to review</button>
          <span class="workflow-hint">Selected questions and students will be assigned together.</span>
        </div>
      </section>
    </div>
  </div>
  </div>
