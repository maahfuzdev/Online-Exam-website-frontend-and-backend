        <!-- Students Tab -->
        <div id="studentsTab" class="tab-content hidden">
          <div class="section-title">
             Student Management
          </div>

          <!-- Update Existing Student Class Form -->
          <div class="form-section">
            <h3 style="font-weight: 600; margin-bottom: 20px; color: #1a202c;">Update Existing Student Class</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
              <div class="form-group">
                <label class="form-label" for="studentEmail">Registered Student Email</label>
                <input type="email" class="form-input" id="studentEmail" placeholder="student@example.com" autocomplete="email">
              </div>
              <div class="form-group">
                <label class="form-label" for="studentClass">New Class</label>
                <input type="text" class="form-input" id="studentClass" placeholder="e.g. Class 9 or HSC 2027" maxlength="40">
              </div>
            </div>
            <div class="action-buttons">
              <button class="btn btn-teacher" id="studentSubmitButton" onclick="updateStudentClassByEmail()"> Update Class</button>
              <button class="btn" onclick="clearStudentForm()"> Clear</button>
            </div>
          </div>

          <!-- Students List -->
          <div style="margin-top: 40px;">
            <h3 style="font-weight: 600; margin-bottom: 20px; color: #1a202c;"> All Students</h3>
            <div style="max-width:320px;margin-bottom:16px"><label class="form-label" for="managedStudentClassFilter">Filter by class</label><select class="form-input" id="managedStudentClassFilter" onchange="loadStudentsList()"><option value="">All classes</option></select></div>
            <div style="overflow-x: auto;">
              <table class="results-table">
                <thead>
                  <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Class</th>
                    <th>Exams Taken</th>
                    <th>Avg. Score</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="studentsList">
                  <!-- Students will be loaded here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
