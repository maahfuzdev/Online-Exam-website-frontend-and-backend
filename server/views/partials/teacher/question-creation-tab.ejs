<div id="questionCreationTab" class="tab-content hidden">
  <div class="section-title">Question Creation</div>
  <p style="color:#64748b;max-width:720px;margin:0 0 24px;line-height:1.6">Create and save reusable questions first. Add them to an exam later from the Exams workspace.</p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
    <article class="form-section" style="margin:0;padding:28px">
      <span style="display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#e8edff;color:#435dcc;font-size:22px"><i class="fas fa-pen-to-square"></i></span>
      <h3 style="margin:18px 0 8px;color:#1a202c">Create questions manually</h3>
      <p style="color:#64748b;line-height:1.6">Write mathematical or general questions, add MCQ choices or create written questions, and save them to your question bank.</p>
      <button class="btn btn-teacher" type="button" onclick="goToManualQuestionCreation()">Open manual question creator</button>
    </article>
    <article class="form-section" style="margin:0;padding:28px">
      <span style="display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#e7f7f1;color:#087f6d;font-size:22px"><i class="fas fa-file-arrow-up"></i></span>
      <h3 style="margin:18px 0 8px;color:#1a202c">Create questions with OCR</h3>
      <p style="color:#64748b;line-height:1.6">Upload a scanned paper, review the extracted questions and answers, then save approved questions to your bank.</p>
      <button class="btn btn-primary" type="button" onclick="showOCRSystem()">Open OCR question creator</button>
    </article>
  </div>
</div>
